# Copie para .env (não versionado) e preencha.

# Domínio dos e-mails institucionais aceitos no login.
EMAIL_DOMINIO=tauge.com

# ID do cliente OAuth 2.0 (tipo "Aplicativo da Web") criado no Google Cloud Console.
# Origens JavaScript autorizadas: a URL em que o painel é acessado.
GOOGLE_CLIENT_ID=

# Segredo para assinar as sessões. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=

# Arquivo com os usuários e senhas (criptografadas). Padrão: usuarios.json na raiz.
# USUARIOS_ARQUIVO=usuarios.json

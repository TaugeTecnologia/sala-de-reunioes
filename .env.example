# Copie para .env (não versionado) e preencha.

# Domínio dos e-mails institucionais aceitos no login.
EMAIL_DOMINIO=tauge.com

# ID do cliente OAuth 2.0 (tipo "Aplicativo da Web") criado no Google Cloud Console.
# Origens JavaScript autorizadas: a URL em que o painel é acessado.
GOOGLE_CLIENT_ID=

# Segredo para assinar as sessões. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=

# Arquivo com os usuários e senhas (criptografadas). Padrão: usuarios.json na raiz.
# USUARIOS_ARQUIVO=usuarios.json

# --- Front no GitHub Pages, backend neste servidor ---
# Origem(ns) do front autorizadas a chamar a API (separadas por vírgula). Ativa CORS com cookies
# e passa o cookie de sessão para SameSite=None; Secure, o que exige HTTPS no backend.
ORIGENS_PERMITIDAS=https://taugetecnologia.github.io
# Nome(s) de host pelo qual o backend é acessado (ex.: api.tauge.com).
HOSTS_PERMITIDOS=
# Endereço/porta de escuta (atrás de um proxy HTTPS, mantenha 127.0.0.1).
HOST=127.0.0.1
PORTA=8787

# Túnel com endereço fixo (docker compose --profile fixo up -d).
# TUNNEL_TOKEN=
